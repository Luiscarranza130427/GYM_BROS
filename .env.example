# Copiar este archivo a `.env` para desarrollo local:
#   cp .env.example .env
# `.env` está ignorado por Git. Nunca añadir aquí claves ni tokens reales:
# todo lo que empieza por VITE_ acaba dentro del bundle público del navegador.

# Nombre visible de la aplicación (título del documento, layout de acceso, sidebar).
VITE_APP_NAME=Gym Bros

# URL base de la API REST de Laravel 11. Todavía no existe (la desarrolla Natan);
# sólo se utiliza cuando VITE_USE_MOCKS=false.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true  -> la capa de servicios responde con datos simulados de src/mocks/
# false -> la capa de servicios habla con la API real de Laravel
VITE_USE_MOCKS=true
